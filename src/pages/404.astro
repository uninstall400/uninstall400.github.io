---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — fateStray">
  <main id="main" class="not-found shell">
    <p class="section-label">404</p>
    <h1 data-i18n="notFound.title">This page drifted away.</h1>
    <p data-i18n="notFound.body">
      The link may be old, or the page may have moved.
    </p>
    <a class="button button--primary" href="/" data-i18n="notFound.back">
      Return home
    </a>
  </main>
</BaseLayout>

